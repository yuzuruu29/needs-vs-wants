# Android / Gradle
.gradle/
build/
*.apk
*.aab
# Soft-launch site hosts public download APKs (Vercel upload respects gitignore)
!website/public/downloads/*.apk
!website/downloads/*.apk
# One-off build/deploy artifacts
*.tgz
build.log
local.properties
.idea/
*.iml

# Android SDK (committed locally, not needed in repo)
.android-sdk/

# Screenshots / design artifacts
*.png
*.jpg
# ...but keep the app-icon brand sources trackable
!docs/assets/brand/*

# iOS build artifacts
ios/DerivedData/
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/artifacts/

# OS
.DS_Store
Thumbs.db

.vercel

# Brainstorm / agent session artifacts
.superpowers/

# pre-reformat backup
.env
.env.local
.env.*.local

.hilo/

# Remotion promo project
video/node_modules/
video/out/
video/.remotion/
video/dist/
video/*.log

# Agent tooling / session dirs
.reasonix/
.zcode/
.commandcode/
.playwright-mcp/
.codex/

# Generated graph caches
website/graphify-out/
.graphify/cache/


# Python caches
__pycache__/
docs/**/__pycache__/
*.pyc

# Local-only release signing (keystore + passwords) — never commit
.local/

# Cursor debug-session NDJSON logs
debug-*.log

# Supabase CLI local cache (project-ref etc. stay; version stamps churn)
supabase/.temp/

# Vault-gate daily stamp (written by .claude/hooks/vault-gate.js)
.claude/.vault-gate

# Local LLM orientation dump (not source of truth — vault + AGENTS.md are).
# Root-only: the archived snapshot in docs/archive/ IS tracked.
/CHATGPT_CONTEXT.md
.freebuff/
