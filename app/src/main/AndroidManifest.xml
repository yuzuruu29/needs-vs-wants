<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Supabase auth / entitlement remote calls (Task 3 seam; unused while SUPABASE_URL is blank) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".NeedsVsWantsApp"
        android:allowBackup="false"
        android:icon="@drawable/app_icon_crop_center"
        android:roundIcon="@drawable/app_icon_crop_center"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeedsVsWants">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NeedsVsWants">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- PayPal return / cancel deep links (subscription application_context) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="needsvswants"
                    android:host="paypal" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.NvwWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nvw_widget_info" />
        </receiver>

        <!-- On-demand WorkManager via NeedsVsWantsApp (Configuration.Provider + HiltWorkerFactory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            AdMob App ID. TEST ID — replace with the production AdMob App ID
            before release. INERT since D87: the AdMob/UMP SDK is stripped
            from the build (lean APK); this meta-data only matters once the
            SDK is restored (see gradle/libs.versions.toml + AdsConfig).
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>
</manifest>
